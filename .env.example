# ============================================================
#  数字人口播 MVP · 环境变量
#  cp .env.example .env  然后填入真实密钥
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 前端/媒体文件对外地址；本地直接跑用 127.0.0.1，接公网隧道时改成 https 地址
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 没有任何密钥时设为 1，可离线跑通全流程（模拟音色 + 本地循环视频）
MOCK_PROVIDERS=0

# ---------- MiniMax（声音复刻 + TTS） ----------
VERASPEAK_MINIMAX_API_KEY=
VERASPEAK_MINIMAX_ORIGIN=https://api.minimaxi.com
VERASPEAK_MINIMAX_MODEL=speech-2.8-hd
# 可选：国内账号若要求把 GroupId 拼进 query 才填
VERASPEAK_MINIMAX_GROUP_ID=
# 可选：指定已复刻好的 voice_id；留空则每次自动生成
VERASPEAK_MINIMAX_VOICE_ID=

# ---------- 腾讯智影（数智人 · 视频免训练） ----------
TENCENT_APPKEY=
TENCENT_ACCESSTOKEN=
TENCENT_APPID=
# 智影 aPaaS 网关（国内环境如为其他域名请覆盖）
TENCENT_BASE_URL=https://gw-sg.tvs.qq.com
# 签名是否把 appid 拼进 query（默认不需要）
TENCENT_QUERY_APPID=0
# 可选：Exclusive / Shared，不填由平台按已购资源决定
TENCENT_CONCURRENCY_TYPE=
# 可选：回调地址
TENCENT_CALLBACK_URL=

# ---------- 腾讯云 COS（托管公网可访问的视频/音频） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_ACL=public-read
# 可选 CDN 域名，例如 https://cdn.example.com
COS_CDN_BASE=
COS_PREFIX=digital-human

# ---------- 流水线参数 ----------
# 数据目录（上传、音频、成片、SQLite 都在这里）
DATA_DIR=./data
# 自定义 ffmpeg 路径（默认走 PATH；要烧录字幕需指向带 libass 的 ffmpeg，如 ffmpeg-full）
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 送给智影的参考视频上限（秒），建议 10-120
MAX_VIDEO_SECONDS=120
# 截取给声音复刻的干净人声长度（MiniMax 要求 10-300 秒）
CLONE_SEGMENT_SECONDS=24
# 是否把字幕（含「AI 生成」角标）压进成片
BURN_SUBTITLES=1
MAX_UPLOAD_MB=500
MAX_TEXT_CHARS=1200
POLL_INTERVAL_SECONDS=2
POLL_TIMEOUT_SECONDS=900
# TTS 语速倍率（0.5-2.0）
TTS_SPEED=1.0
LOG_LEVEL=INFO
